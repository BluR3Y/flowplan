{
    "version": "1.0",
    "pipeline_id": "example-pl",
    "metadata": {
        "description": "Example pipeline configuration demonstrates all core features"
    },
    "timezone": "America/New_York",
    "output": "${FLOWPLAN_OUT}/flowplan_out",
    "resources": {  // Credentials
        "excel_1_conn": {   // Resource is a 'collection'
            "adapter": "file",
            "params": {
                "format": "excel",
                "path": "C:/Data/grants_book.xlsx"
            },
            "allow": ["read", "write"]
        },
        "json_1_conn": {    // Resource is a 'set'
            "adapter": "file",
            "params": {
                "format": "json",
                "path": "C:/Data/misc_data.json"
            },
            "allow": ["read"]
        },
        "access_1_conn": {  // Resource is a 'collection'
            "adapter": "db",
            "params": {
                "engine": "access",
                "path": "C:/Data/grants_db.accdb"
            }
        },
        "csv_1_conn": {     // Resource is a 'set'
            "adapter": "file",
            "params": {
                "format": "csv",
                "path": "C:/Data/simple_data.csv"
            }
        },
        "postgre_1_conn": {
            "adapter": "db",
            "params": {
                "engine": "postgres",
                "uri": "jdbc:postgresql://db-internal:5432/orders"
            }
        }
    },
    "tasks": [
        {
            "task_id": "extract_excel_1_sheet_1",
            "action": "transfer",
            // "steps": [
            //     {
            //         "op": "extract",
            //         "params": {
            //             "resource": "excel_1_conn",
            //             "collection": "Sheet1",
            //             "keys": [
            //                 "grant_id",
            //                 "Title",
            //                 "submission_date",
            //                 "Status"
            //             ]
            //         }
            //     }
            // ],
            // "steps": [
            //     {
            //         "resource": "excel_1_conn",
            //         "params": {
            //             "op": "extract",
            //             "collection": "Sheet1",
            //             "keys": [
            //                 "grant_id",
            //                 "Title",
            //                 "submission_date",
            //                 "Status"
            //             ]
            //         }
            //     }
            // ],
            "steps": [
                
            ],
            "retry_policy": { "max_attempts": 3, "delay": 30 }
        },
        {
            "task_id": "extract_excel_1_sheet_2",
            "action": "transfer",
            "steps": [
                {
                    "op": "extract",
                    "params": {
                        "resource": "excel_1_conn",
                        "collection": "Sheet2",
                        "keys": [
                            "Grant_ID",
                            "Project Title",
                            "Submit",
                            "grant status"
                        ]
                    }
                }
            ]
        },
        {
            "task_id": "extract_access_1_table_1",
            "action": "transfer",
            "steps": [
                {
                    "op": "extract",
                    "params": {
                        "resource": "access_1_conn",
                        "collection": "Table1",
                        "keys": [
                            "Grant_ID",
                            "Project_Title",
                            "Award_No",
                            "PI_Name",
                            "StatusText",
                            "Date_Submitted"
                        ]
                    }
                }
            ]
        },
        {
            "task_id": "extract_json_1",
            "action": "transfer",
            "steps": [
                {
                    "op": "extract",
                    "params": {
                        "resource": "json_1_conn",
                        "keys": ["Name", "Code"]
                    }
                }
            ]
        },
        {
            "task_id": "clean_grants",
            "action": "transform",
            "input": ["extract_excel_1_sheet_1"],
            "steps": [
                { "op": "label", "params": { "Grant ID": "grant_id", "Project_Title": "title", "Award_No": "award_number" } },
                { "op": "map", "params": { "status": { "Open": "Active", "Closed": "Inactive" }, "department": { "computer science": "comp_sci", "mathematics": "math", "phys ed": "gym" } } },
                { "op": "regex_replace", "params": { "grant_id": { "pattern": "^jjc-", "repl": "", "flags": "i" }, "grant_pln": { "pattern": "^jjc-", "repl": "", "flags": "i" } } },
                { "op": "cast", "params": { "grant_id": "integer", "grant_pln": "integer", "submission_date": "date" } },
                { "op": "affix", "params": { "grant_id": { "text": "-award", "position": "suffix" }, "grant_pln": { "text": "JJC-", "position": "prefix" } } },
                { "op": "text_norm", "params": { "title": ["nfkc", "strip", "upper"], "status": ["strip", "lower"] } }
            ]
        },
        {
            "task_id": "order_grants",
            "action": "transform",
            "input": ["extract_excel_1_sheet_2"],
            "steps": [
                { "op": "filter", "params": { "AND": [ { "status": { "op": "==", "value": "Active" } }, { "grant_id": { "op": ">=", "value": 100 } } ] } },
                { "op": "sort", "params": { "grant_id": "asc", "grant_pln": "desc" } },
                { "op": "dedupe", "params": { "on": "grant_pln", "keep": "first" } },
                { "op": "group", "params": { "by": "grant_id" } }
            ]
        },
        {
            "task_id": "combine_grants",
            "action": "transform",
            "input": ["clean_grants", "order_grants"],
            "steps": [
                { "op": "merge", "params": { "left": "clean_grants", "right": "order_grants", "how": "inner", "on": "grant_id" } },
                { "op": "join", "params": { "left": "clean_grants", "right": "order_grants", "how": "left", "on": "grant_pln" } }
            ]
        },
        {
            "task_id": "load_clean_grants",
            "action": "transfer",
            "input": ["combine_grants"],
            "steps": [
                {
                    "op": "load",
                    "params": {
                        "resource": "json_1_conn",
                        "mode": "overwrite"
                    }
                }
            ]
        }
    ]
}